const apiBase = '/api';

function formatRange(documentRow) {
  const start = documentRow.date_start ?? 'n/a';
  const end = documentRow.date_end ?? 'n/a';
  return `${start}–${end}`;
}

function renderStats(stats) {
  document.getElementById('totalDocuments').textContent = stats.total_documents;
  document.getElementById('totalReligions').textContent = stats.religions;
  document.getElementById('totalTraditions').textContent = stats.traditions;
  document.getElementById('timelineSpan').textContent = `${stats.earliest_year}–${stats.latest_year}`;
}

function renderBreakdown(breakdown) {
  const container = document.getElementById('religionBreakdown');
  container.innerHTML = breakdown
    .map(
      (item, index) => `
        <div class="breakdown-row">
          <div class="breakdown-label">
            <span class="dot" style="background:${['#34d399','#60a5fa','#fbbf24','#f472b6','#f87171'][index % 5]}"></span>
            <span>${item.religion}</span>
          </div>
          <strong>${item.count}</strong>
        </div>
      `
    )
    .join('');
}

function renderTimeline(items) {
  const container = document.getElementById('timeline');
  const maxDuration = Math.max(...items.map(item => Math.max(1, (item.date_end || item.date_start || 0) - (item.date_start || item.date_end || 0))), 1);

  container.innerHTML = items
    .map((item) => {
      const duration = Math.max(20, Math.abs((item.date_end || item.date_start || 0) - (item.date_start || item.date_end || 0)) || 20);
      const height = Math.min(180, (duration / maxDuration) * 180 + 20);
      return `
        <div class="timeline-item">
          <div class="timeline-bar" style="height:${height}px"></div>
          <small>${item.title.slice(0, 18)}</small>
        </div>
      `;
    })
    .join('');
}

function renderDocuments(documents) {
  const searchTerm = document.getElementById('searchInput').value.toLowerCase();
  const filtered = documents.filter((doc) => {
    const haystack = [doc.title, doc.religion, doc.tradition, doc.language, doc.source, doc.summary]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
    return haystack.includes(searchTerm);
  });

  const list = document.getElementById('documentList');
  list.innerHTML = filtered
    .map(
      (doc) => `
        <article class="document-card">
          <div class="meta">
            <span class="badge">${doc.religion}</span>
            <span class="badge">${doc.language || 'unknown'}</span>
            <span class="badge">${doc.status}</span>
          </div>
          <h3>${doc.title}</h3>
          <p><strong>${formatRange(doc)}</strong></p>
          <p>${doc.summary || 'No summary provided yet.'}</p>
          <p><em>${doc.source || 'Unknown source'}</em></p>
        </article>
      `
    )
    .join('');
}

async function loadDashboard() {
  const response = await fetch(`${apiBase}/dashboard`);
  const data = await response.json();

  renderStats(data.stats);
  renderBreakdown(data.religion_breakdown);
  renderTimeline(data.documents.slice(0, 8));
  renderDocuments(data.documents);
}

async function submitDocument(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  const response = await fetch(`${apiBase}/documents`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  });

  if (response.ok) {
    form.reset();
    await loadDashboard();
  }
}

document.getElementById('refreshBtn').addEventListener('click', loadDashboard);
document.getElementById('searchInput').addEventListener('input', () => {
  fetch(`${apiBase}/dashboard`)
    .then((res) => res.json())
    .then((data) => {
      renderDocuments(data.documents);
    });
});
document.getElementById('documentForm').addEventListener('submit', submitDocument);

loadDashboard();
